    function guardarEdicion(idOriginal) {
      const nuevaFecha = document.getElementById(`editFecha_${idOriginal}`).value;
      const nuevaHora = document.getElementById(`editHora_${idOriginal}`).value.trim();
      const nuevoMotivo = document.getElementById(`editMotivo_${idOriginal}`).value.trim();

      if (!nuevaFecha) return alert("Por favor selecciona una fecha válida.");

      if (registros.some(r => r.fecha === nuevaFecha && r.id !== idOriginal)) {
        return alert("Ya existe un registro guardado en la nueva fecha seleccionada.");
      }

      const horaDefinitiva = nuevaHora !== "" ? nuevaHora : "No especificada";

      if (esModoInvitado) {
        const index = registros.findIndex(r => r.id === idOriginal);
        if (index !== -1) {
          registros[index] = {
            id: idOriginal,
            fecha: nuevaFecha,
            hora: horaDefinitiva,
            motivo: nuevoMotivo
          };
          registros.sort((a, b) => b.fecha.localeCompare(a.fecha));
          guardarDatosLocales();
          editandoId = null;
          poblarSelectorAnio();
          mostrarRegistros();
        }
      } else {
        db.collection("usuarios").doc(usuarioActual.uid).collection("llegadas").doc(idOriginal).update({
          fecha: nuevaFecha,
          hora: horaDefinitiva,
          motivo: nuevoMotivo
        }).then(() => {
          editandoId = null;
        }).catch(err => alert("Error al actualizar en la nube: " + err.message));
      }
    }

