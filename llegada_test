    // ============ CALENDARIO ANUAL EN EXCEL REAL (ExcelJS) ============
    const DIAS_SEMANA_DOM = ["D", "L", "M", "X", "J", "V", "S"];

    function numeroSemanaAnio(fecha, anio) {
      const inicioAnio = new Date(anio, 0, 1);
      const diaSemanaInicio = inicioAnio.getDay();
      const primerDomingo = new Date(anio, 0, 1 - diaSemanaInicio);
      const diffDias = Math.round((fecha - primerDomingo) / 86400000);
      return Math.floor(diffDias / 7) + 1;
    }

    function generarSemanasMes(anio, mes) {
      const primerDia = new Date(anio, mes - 1, 1);
      const ultimoDia = new Date(anio, mes, 0);

      let inicioSemana = new Date(primerDia);
      inicioSemana.setDate(inicioSemana.getDate() - inicioSemana.getDay());

      let semanas = [];
      while (inicioSemana <= ultimoDia) {
        const weekNum = numeroSemanaAnio(inicioSemana, anio);
        let dias = [];
        for (let i = 0; i < 7; i++) {
          const d = new Date(inicioSemana);
          d.setDate(d.getDate() + i);
          dias.push(d.getMonth() === mes - 1 ? d.getDate() : null);
        }
        semanas.push({ weekNum, dias });
        inicioSemana.setDate(inicioSemana.getDate() + 7);
      }
      return semanas;
    }

    const COL_INICIO_MES = [1, 10, 19];
    const COLUMNAS_TOTALES = 26; 
    const COL_TABLA_INICIO = COLUMNAS_TOTALES + 2; 

    function agregarBloqueTresMesesExcel(ws, anio, mesInicio, filaInicio, bordeCompleto) {
      const meses = [mesInicio, mesInicio + 1, mesInicio + 2];
      const datosMeses = meses.map(mes => {
        const mesKey = `${anio}-${String(mes).padStart(2, "0")}`;
        return {
          mes,
          nombreMes: `${obtenerNombreMes(mes)} ${anio}`,
          semanas: generarSemanasMes(anio, mes),
          fechasRegistradas: new Set(
            registros.filter(r => r.fecha.startsWith(mesKey)).map(r => r.fecha)
          )
        };
      });

      const maxSemanas = Math.max(...datosMeses.map(m => m.semanas.length));
      let fila = filaInicio;

      datosMeses.forEach((m, idx) => {
        const colBase = COL_INICIO_MES[idx];
        ws.mergeCells(fila, colBase + 1, fila, colBase + 7);
        for (let c = colBase + 1; c <= colBase + 7; c++) {
          const celda = ws.getCell(fila, c);
          celda.font = { bold: true, color: { argb: "FFFFFFFF" }, size: 12 };
          celda.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FF333333" } };
          celda.alignment = { horizontal: "center", vertical: "middle" };
          celda.border = bordeCompleto;
        }
        ws.getCell(fila, colBase + 1).value = m.nombreMes;
      });
      fila++;

      datosMeses.forEach((m, idx) => {
        const colBase = COL_INICIO_MES[idx];
        DIAS_SEMANA_DOM.forEach((d, i) => {
          const celda = ws.getCell(fila, colBase + 1 + i);
          celda.value = d;
          celda.font = { bold: true };
          celda.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFDDDDDD" } };
          celda.alignment = { horizontal: "center" };
          celda.border = bordeCompleto;
        });
      });
      fila++;

      for (let i = 0; i < maxSemanas; i++) {
        datosMeses.forEach((m, idx) => {
          const colBase = COL_INICIO_MES[idx];
          const semana = m.semanas[i];

          const celdaSemana = ws.getCell(fila, colBase);
          if (semana) {
            celdaSemana.value = semana.weekNum;
            celdaSemana.font = { size: 9, color: { argb: "FF888888" } };
            celdaSemana.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFF0F0F0" } };
            celdaSemana.alignment = { horizontal: "center" };
          }

          for (let d = 0; d < 7; d++) {
            const celda = ws.getCell(fila, colBase + 1 + d);
            celda.border = bordeCompleto;
            celda.alignment = { horizontal: "center" };
            if (semana && semana.dias[d] !== null) {
              const dia = semana.dias[d];
              celda.value = dia;
              const fechaStr = `${anio}-${String(m.mes).padStart(2, "0")}-${String(dia).padStart(2, "0")}`;
              if (m.fechasRegistradas.has(fechaStr)) {
                celda.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFFF0000" } };
                celda.font = { bold: true, color: { argb: "FFFFFFFF" } };
              }
            }
          }
        });
        fila++;
      }

      return fila;
    }

    function agregarTablaRegistrosExcel(ws, anio, colInicio, bordeCompleto) {
      const filaInicio = 2;
      const registrosAnio = registros
        .filter(r => r.fecha.startsWith(String(anio)))
        .sort((a, b) => a.fecha.localeCompare(b.fecha));

      const encabezados = ["Fecha", "Hora", "Motivo"];
      encabezados.forEach((titulo, i) => {
        const celda = ws.getCell(filaInicio, colInicio + i);
        celda.value = titulo;
        celda.font = { bold: true, color: { argb: "FFFFFFFF" } };
        celda.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FF333333" } };
        celda.alignment = { horizontal: "center" };
        celda.border = bordeCompleto;
      });

      if (registrosAnio.length === 0) {
        const celda = ws.getCell(filaInicio + 1, colInicio);
        ws.mergeCells(filaInicio + 1, colInicio, filaInicio + 1, colInicio + 2);
        celda.value = "Sin registros en este año";
        celda.font = { italic: true, color: { argb: "FF888888" } };
        celda.alignment = { horizontal: "center" };
        celda.border = bordeCompleto;
        return filaInicio + 2;
      }

      registrosAnio.forEach((r, idx) => {
        const fila = filaInicio + 1 + idx;
        const partes = r.fecha.split("-");
        const fechaFormateada = `${partes[2]}/${partes[1]}/${partes[0]}`;
        const valores = [fechaFormateada, r.hora || "-", r.motivo || "-"];
        const filaPar = idx % 2 === 1;

        valores.forEach((valor, i) => {
          const celda = ws.getCell(fila, colInicio + i);
          celda.value = valor;
          celda.alignment = { horizontal: i === 2 ? "left" : "center" };
          celda.border = bordeCompleto;
          if (filaPar) {
            celda.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFF5F5F5" } };
          }
        });
      });

      ws.getColumn(colInicio).width = 12;
      ws.getColumn(colInicio + 1).width = 8;
      ws.getColumn(colInicio + 2).width = 24;
      ws.getColumn(colInicio - 1).width = 2;

      return filaInicio + 1 + registrosAnio.length;
    }

    async function exportarCalendarioAnioExcel() {
      const anio = Number(document.getElementById("anioExportar").value);
      if (!anio) return alert("Selecciona un año.");

      const btn = document.getElementById("btnExportarAnual");
      const textoOriginal = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = "Generando...";

      try {
        const workbook = new ExcelJS.Workbook();
        const ws = workbook.addWorksheet(`${anio}`);

        const bordeFino = { style: "thin", color: { argb: "FF999999" } };
        const bordeCompleto = { top: bordeFino, left: bordeFino, bottom: bordeFino, right: bordeFino };

        ws.mergeCells(1, 1, 1, COLUMNAS_TOTALES);
        const celdaAnio = ws.getCell(1, 1);
        celdaAnio.value = anio;
        celdaAnio.font = { bold: true, size: 16 };
        celdaAnio.alignment = { horizontal: "center" };

        let fila = 2;
        [1, 4, 7, 10].forEach(mesInicio => {
          fila = agregarBloqueTresMesesExcel(ws, anio, mesInicio, fila, bordeCompleto);
          fila++;
        });

        agregarTablaRegistrosExcel(ws, anio, COL_TABLA_INICIO, bordeCompleto);

        for (let c = 1; c <= COLUMNAS_TOTALES; c++) {
          const esColumnaSemana = COL_INICIO_MES.includes(c);
          const esEspaciador = c === 9 || c === 18;
          ws.getColumn(c).width = esEspaciador ? 2 : (esColumnaSemana ? 4 : 5);
        }

        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `calendario_anual_llegadas_${anio}.xlsx`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      } catch (err) {
        alert("Error al generar el Excel. Probá de nuevo.");
      } finally {
        btn.disabled = false;
        btn.innerHTML = textoOriginal;
      }
    }

    function descargarBackup() {
      if (registros.length === 0) return alert("No hay registros para respaldar.");
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(registros, null, 2));
      const a = document.createElement('a');
      a.setAttribute("href", dataStr);
      a.setAttribute("download", `backup_llegadas_${new Date().toISOString().split('T')[0]}.json`);
      document.body.appendChild(a);
      a.click();
      a.remove();
    }

    function importarBackup(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const datos = JSON.parse(e.target.result);
          if (Array.isArray(datos)) {
            if (confirm("¿Reemplazar datos actuales? (Aceptar = Reemplazar, Cancelar = Combinar con existentes)")) {
              registros = datos;
            } else {
              datos.forEach(nuevo => {
                if (!nuevo.id) nuevo.id = Date.now().toString() + Math.random().toString(36).substr(2, 5);
                if (!registros.some(r => r.fecha === nuevo.fecha)) {
                  registros.push(nuevo);
                }
              });
            }
            registros.sort((a, b) => b.fecha.localeCompare(a.fecha));
            if (esModoInvitado) guardarDatosLocales();
            mostrarRegistros();
            poblarSelectorAnio();
            alert("¡Copia de seguridad cargada con éxito! ✅");
          } else {
            alert("El archivo no tiene el formato correcto.");
          }
        } catch (err) {
          alert("Error al leer el archivo JSON.");
        }
        event.target.value = "";
      };
      reader.readAsText(file);
    }

    function borrarTodo() {
      if (confirm("¿Estás seguro de borrar TODOS los registros de llegadas?")) {
        registros = [];
        if (esModoInvitado) {
          localStorage.removeItem(LOCAL_STORAGE_KEY);
        }
        mostrarRegistros();
        poblarSelectorAnio();
      }
    }
  </script>
</body>
