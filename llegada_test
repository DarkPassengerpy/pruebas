                        <button style="width: auto; padding: 0 12px; height: 32px; background: #757575;" onclick="cancelarEdicion()">❌ Cancelar</button>
                      </div>
                    </div>
                  </td>
                </tr>`;
            } else {
              // Modo Lectura normal
              const partes = item.fecha.split("-");
              const fechaFormateada = `${partes[2]}/${partes[1]}/${partes[0]}`;
